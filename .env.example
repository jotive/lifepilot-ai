# ==============================================================================
# RoomIA Monorepo — Canonical Environment Variables (.env)
# Copy this file to apps/api/.env to test locally.
# ==============================================================================

# [REQUERIDO] Configuración del Servidor Express
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# [OPCIONAL - CASCADA DE IA LLM] (Se requiere al menos 1 para llamadas reales a la IA, de lo contrario opera con Fallback Local)
OPENAI_API_KEY=                 # https://platform.openai.com/api-keys (GPT-4o-mini Vision & Chat)
GEMINI_API_KEY=                 # https://aistudio.google.com/app/apikey (Recomendado - Multimodal y Gratis)
OPENROUTER_TOKEN1=              # https://openrouter.ai/keys (Acceso a Claude 3.5 / Llama 3)
GROQ_API_KEY=                   # https://console.groq.com/keys (Llama 3 Ultra Rápido)
ANTHROPIC_API_KEY=              # https://console.anthropic.com/

# [OPCIONAL - BÚSQUEDA Y RADAR DE EVENTOS EN VIVO]
TAVILY_API_KEY=                 # https://app.tavily.com/ (Radar de eventos y lugares en tiempo real)

# [OPCIONAL - NOTIFICACIONES]
RESEND_API_KEY=                 # https://resend.com/api-keys (Envío de correos transaccionales)
