# LifePilot AI - Environment Variables Template
# Copy this file to .env and set your API keys locally if desired.
# NEVER commit your real .env file to GitHub!

# Tavily AI Search API Key (Get your free key at https://tavily.com)
VITE_TAVILY_API_KEY=your_tavily_api_key_here

# Qiro AI / LLM API Endpoint & Key (Optional)
VITE_QIRO_API_KEY=your_qiro_api_key_here
