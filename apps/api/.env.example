# ==============================================================================
# RoomIA API Service — Environment Variables Configuration
# Copy this file to .env (e.g. cp .env.example .env)
# ==============================================================================

# Server Network Settings
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# LLM Providers (Ordered by fallback hierarchy: Gemini -> OpenRouter -> Groq -> Local Rules)
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_TOKEN1=your_openrouter_token_here
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Live Search & Radar Engine
TAVILY_API_KEY=your_tavily_api_key_here

# Hackathon AI Gateway
QIRO_API_KEY=your_qiro_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Notifications & Transactional Emails
RESEND_API_KEY=your_resend_api_key_here
